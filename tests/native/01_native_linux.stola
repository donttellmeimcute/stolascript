// Native Linux program: no libc, no C runtime
function fib(n)
  if n < 2
    return n
  end
  return fib(n - 1) + fib(n - 2)
end

static buffer[64]

print("Hola desde StolasScript nativo (sin libc)")
print("fib(30) =", fib(30))
x = 0
for i in range(1, 11)
  x += i * i
end
print("suma de cuadrados:", x)
p = alloc(100)
str_copy(p, "copiado al heap")
print(as_str(p), strlen(p))
store64(buffer, 0xDEADBEEF)
print_hex(load64(buffer))
print_char(10)
print("argc =", argc())
i = 1
while i < argc()
  print(" argv:", argv(i))
  i += 1
end
print(-12345, parse_int("-42") * 2, str_eq("abc", "abc"), 7 > 3)
t0 = clock_ns()
sleep_ms(20)
print("slept >= 20ms:", (clock_ns() - t0) / 1000000 >= 20)
exit(3)
